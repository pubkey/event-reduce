{
    "extends": [
        "config:base"
    ],
    "statusCheckVerify": true,
    "ignoreDeps": [],
    "automerge": true,
    "major": {
        "automerge": true
    },
    "ignorePaths": [],
    "rebaseStalePrs": true,
    "prHourlyLimit": 4,
    "dependencyDashboard": false,
    "packageRules": [
        {
            "description": "typescript-eslint does not support TypeScript 7 yet (peer range <6.1.0)",
            "matchPackageNames": [
                "typescript"
            ],
            "allowedVersions": "<7"
        }
    ]
}
