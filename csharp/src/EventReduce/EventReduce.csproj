<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 and C# 9 so the library also works in Unity -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- members whose name says everything have no doc comment -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>EventReduce</RootNamespace>
    <PackageId>EventReduce</PackageId>
    <Version>7.4.1</Version>
    <Description>Update live query results from database change events without re-running the query.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/pubkey/event-reduce</RepositoryUrl>
    <PackageProjectUrl>https://github.com/pubkey/event-reduce</PackageProjectUrl>
    <Authors>pubkey</Authors>
    <PackageTags>live-query;reactive;realtime;database;bdd</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
