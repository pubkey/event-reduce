{
    "name": "event-reduce-examples-browser",
    "version": "1.0.0",
    "scripts": {
        "lint": "eslint .",
        "start": "webpack-dev-server --config webpack.dev.js",
        "test:e2e": "testcafe chrome -e test/ --hostname localhost --compiler-options \"typescript.customCompilerModulePath=../typescript;typescript.configPath=test/tsconfig.json\"",
        "test": "concurrently \"npm run serve\" \"sleep 4 && npm run test:e2e\" --kill-others --success first",
        "mongo": "bash mongodb.bash",
        "serve": "ws -p 8888 -d dist/",
        "build": "webpack --config webpack.js && cp ./index.html ./dist/index.html"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pubkey/event-reduce.git"
    },
    "author": "pubkey",
    "bugs": {
        "url": "https://github.com/pubkey/event-reduce/issues"
    },
    "homepage": "https://github.com/pubkey/event-reduce#readme",
    "dependencies": {
        "@faker-js/faker": "10.6.0",
        "@types/nedb": "1.8.16",
        "@types/pouchdb-core": "7.0.15",
        "async-test-util": "2.5.0",
        "event-reduce-js": "file:../../javascript/",
        "json-pretty-html": "1.1.6",
        "minimongo": "7.1.1",
        "nedb": "1.8.0",
        "pouchdb-adapter-idb": "9.0.0",
        "pouchdb-adapter-indexeddb": "9.0.0",
        "pouchdb-adapter-memory": "9.0.0",
        "pouchdb-core": "9.0.0",
        "pouchdb-find": "9.0.0",
        "rxjs": "7.8.2",
        "stream": "0.0.3",
        "webpack": "5.112.0",
        "webpack-cli": "7.2.3"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "assert": "2.1.0",
        "concurrently": "10.0.6",
        "css-loader": "7.1.5",
        "eslint": "10.12.0",
        "less": "4.9.1",
        "less-loader": "13.0.0",
        "local-web-server": "5.4.0",
        "path": "0.12.7",
        "style-loader": "4.0.0",
        "testcafe": "3.7.6",
        "ts-loader": "9.6.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "util": "0.12.5",
        "webpack-dev-server": "6.0.0"
    }
}
