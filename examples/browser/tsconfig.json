{
    "compilerOptions": {
        "outDir": "./dist/",
        "sourceMap": true,
        "strict": false,
        "moduleResolution": "bundler",
        "module": "es2020",
        "target": "es2018",
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "lib": [
            "es2018",
            "dom"
        ]
    },
    "exclude": [
        "node_modules",
        ".git"
    ]
}
